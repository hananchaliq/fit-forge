{
  "model": "/models/trainer.glb",
  "meshName": "Body",
  "skeleton": "mixamo",
  "clips": ["idle","pushup","squat","lunge","plank","burpee","mountain_climber","crunch","glute_bridge","stretch_flow","jog"],
