# GEMINI_API_KEY: Required for Gemini AI API calls (/api/analyze-food).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Configuration (Optional - falls back to local IndexedDB/Zustand store with realistic seed data)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Web Push VAPID Keys (Optional - for push notifications)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
